# Copy to .env on the server (chmod 600). Never commit .env.

# PostgreSQL container
POSTGRES_USER=autoneg
POSTGRES_PASSWORD=change-me
POSTGRES_DB=autoneg

# FastAPI / Celery
DATABASE_URL=postgresql+asyncpg://autoneg:change-me@postgresql:5432/autoneg
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
CORS_ORIGINS=["https://autonegotiater.com","https://www.autonegotiater.com"]

# Next.js server-side calls to FastAPI over the Podman network
API_INTERNAL_URL=http://fastapi:8000
